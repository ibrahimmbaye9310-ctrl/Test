# ─────────────────────────────────────────────────────────────
# JobFinder — variables d'environnement
# Copiez ce fichier en .env.local et complétez les valeurs.
# NE COMMITTEZ JAMAIS .env.local : il contient des secrets.
# ─────────────────────────────────────────────────────────────

# URL publique du site (sans slash final). En local : http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Supabase (phase 3) ── Dashboard Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret : uniquement côté serveur (webhooks, tâches admin). Jamais préfixé NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ── Stripe (phase 7) ── Dashboard Stripe (mode Test) > Développeurs > Clés API
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_SINGLE_OFFER=

# ── Resend (phase 8) ── resend.com > API Keys
RESEND_API_KEY=
EMAIL_FROM="JobFinder <no-reply@votre-domaine.fr>"

# Affiche les offres de démonstration (fictives, clairement signalées).
# Doit valoir "false" en production.
NEXT_PUBLIC_ENABLE_DEMO_DATA=true
