# ─────────────────────────────────────────────────────────────
# JobFinder — variables d'environnement
# Copiez ce fichier en .env.local et complétez les valeurs.
# NE COMMITTEZ JAMAIS .env.local : il contient des secrets.
# ─────────────────────────────────────────────────────────────

# URL publique du site (sans slash final). En local : http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Supabase ── Dashboard Supabase > Project Settings > API Keys (anciennes clés anon/service_role acceptées)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# SECRET : uniquement côté serveur (suppression de compte, webhooks, admin). Jamais préfixé NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# ── Stripe ── Voir docs/STRIPE.md. Commencer en mode Test (clés sk_test_…).
# Clé secrète : Dashboard Stripe > Développeurs > Clés API. SERVEUR UNIQUEMENT.
STRIPE_SECRET_KEY=
# Secret de signature du webhook (whsec_…) : Développeurs > Webhooks > votre endpoint.
STRIPE_WEBHOOK_SECRET=
# Identifiants des prix, affichés par : STRIPE_SECRET_KEY=sk_test_… node scripts/stripe-setup.mjs
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_SINGLE_OFFER=
# "true" seulement après avoir configuré Stripe Tax (TVA) dans le Dashboard.
STRIPE_AUTOMATIC_TAX=false
# Facultatif (tests uniquement) : clé de facturation si SUPABASE_SECRET_KEY n'est pas disponible.
BILLING_KEY=

# ── Resend (phase 8) ── resend.com > API Keys
RESEND_API_KEY=
EMAIL_FROM="JobFinder <no-reply@votre-domaine.fr>"

# Affiche les offres de démonstration (fictives, clairement signalées).
# Doit valoir "false" en production.
NEXT_PUBLIC_ENABLE_DEMO_DATA=true

# ── Sécurité ── Sel secret de la limitation des tentatives (chaîne aléatoire de 32+ caractères).
# Générer : openssl rand -hex 32   (ou un générateur de mots de passe)
RATE_LIMIT_SECRET=
